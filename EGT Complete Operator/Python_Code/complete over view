\section{Coherence functional}

Coherence measures how close a state is to the attractor configuration. For positive parameters
\[
\alpha_A, \alpha_C, \alpha_w, \alpha_\sigma > 0,
\]
we define the coherence functional
\begin{equation}
\label{eq:coherence}
\mathcal{C}(s)
=
\exp\left(
-\left[
\alpha_A (A - A_*)^2
+ \alpha_C C^2
+ \alpha_w (w - w_*)^2
+ \alpha_\sigma \sigma^2
\right]
\right).
\end{equation}

\subsection{Properties of coherence}

\begin{theorem}[Coherence maximum]
For all $s \in \mathcal{S}$, we have $0 < \mathcal{C}(s) \le 1$, and
\[
\mathcal{C}(s) = 1
\iff
A = A_*,\ C = 0,\ w = w_*,\ \sigma = 0.
\]
Otherwise $\mathcal{C}(s) < 1$.
\end{theorem}

\begin{proof}
Let
\[
E(s) = \alpha_A (A - A_*)^2
+ \alpha_C C^2
+ \alpha_w (w - w_*)^2
+ \alpha_\sigma \sigma^2.
\]
Each term is nonnegative, hence $E(s) \ge 0$. Moreover, $E(s) = 0$ if and only if
\[
A = A_*, \quad C = 0, \quad w = w_*, \quad \sigma = 0.
\]
For any other state, $E(s) > 0$.

By definition,
\[
\mathcal{C}(s) = e^{-E(s)}.
\]
Since $E(s) \ge 0$, we have $0 < \mathcal{C}(s) \le 1$. Additionally, $E(s) = 0$ implies $\mathcal{C}(s) = 1$, and $E(s) > 0$ implies $0 < \mathcal{C}(s) < 1$.
\end{proof}

\section{Connectivity law}

The connectivity functional is defined by
\begin{equation}
\label{eq:connectivity}
\mathcal{K}(s) = G\,\mathcal{C}(s).
\end{equation}

We assume a maximal allowed connectivity scale $G_* > 0$ and restrict $G$ to satisfy
\[
0 < G \le G_*.
\]

\subsection{Normalized connectivity}

We define the normalized connectivity
\begin{equation}
\label{eq:Knorm}
\mathcal{K}_{\mathrm{norm}}(s)
=
\frac{\mathcal{K}(s)}{G_*}
=
\frac{G}{G_*}
\exp\left(
-\left[
\alpha_A (A - A_*)^2
+ \alpha_C C^2
+ \alpha_w (w - w_*)^2
+ \alpha_\sigma \sigma^2
\right]
\right).
\end{equation}

\begin{theorem}[Connectivity law]
Under the constraint $0 < G \le G_*$, we have
\[
\mathcal{K}_{\mathrm{norm}}(s) \in (0,1]
\]
for all $s \in \mathcal{S}$, and
\[
\mathcal{K}_{\mathrm{norm}}(s) = 1
\iff
A = A_*,\ C = 0,\ w = w_*,\ \sigma = 0,\ G = G_*.
\]
\end{theorem}

\begin{proof}
We have $0 < \mathcal{C}(s) \le 1$ and $0 < G \le G_*$, hence
\[
\frac{G}{G_*} \in (0,1], \quad \mathcal{C}(s) \in (0,1],
\]
and thus
\[
\mathcal{K}_{\mathrm{norm}}(s)
=
\frac{G}{G_*}\,\mathcal{C}(s)
\in (0,1]\cdot(0,1] = (0,1].
\]

Equality $\mathcal{K}_{\mathrm{norm}}(s) = 1$ holds if and only if both factors are $1$:
\[
\mathcal{C}(s) = 1, \quad \frac{G}{G_*} = 1.
\]
By the coherence maximum theorem, $\mathcal{C}(s) = 1$ implies
\[
A = A_*,\ C = 0,\ w = w_*,\ \sigma = 0.
\]
The condition $G/G_* = 1$ is equivalent to $G = G_*$. This completes the proof.
\end{proof}

\section{Black-hole mapping}

We define a black-hole parameter space
\[
\mathcal{B} \subset \mathbb{R}^3, \quad \mathcal{B} = \{(M, \Lambda, \alpha)\},
\]
with:
\begin{itemize}
  \item $M$ an effective mass,
  \item $\Lambda$ an effective cosmological term,
  \item $\alpha$ a dimensionless emergent spin parameter.
\end{itemize}

For constants $k_M, k_\Lambda, k_\alpha > 0$, we define the map $\Phi: \mathcal{S} \to \mathcal{B}$ by
\begin{equation}
\label{eq:Phi}
\begin{aligned}
M(s) &= k_M A G,\\
\Lambda(s) &= k_\Lambda (1 + w),\\
\alpha(s) &= k_\alpha \frac{G - 1}{1 + \sigma}.
\end{aligned}
\end{equation}

Using the connectivity definition \eqref{eq:connectivity}, we may write
\[
G = \frac{\mathcal{K}(s)}{\mathcal{C}(s)},
\]
so that
\[
M(s) = k_M A \frac{\mathcal{K}(s)}{\mathcal{C}(s)}, \quad
\alpha(s) = k_\alpha \frac{1}{1+\sigma} \left(\frac{\mathcal{K}(s)}{\mathcal{C}(s)} - 1\right).
\]

Thus, effective mass and emergent spin become explicit functions of connectivity and the remaining state parameters.

\section{Bres curvature}

We define the Bres radius by
\begin{equation}
\label{eq:BresRadius}
R_B(s) = B \frac{A_*}{A}.
\end{equation}
For a base curvature scale $\kappa_0 > 0$ and sensitivity parameter $\gamma \ge 0$, we define the Bres curvature
\begin{equation}
\label{eq:BresCurvature}
K_B(s)
=
\frac{\kappa_0}{[R_B(s)]^2}(1 + \gamma |C|)
=
\frac{\kappa_0}{B^2}\left(\frac{A}{A_*}\right)^2 (1 + \gamma |C|).
\end{equation}

We also define a reference curvature
\begin{equation}
\label{eq:Kstar}
K_* = \frac{\kappa_0}{B^2}.
\end{equation}

Then
\begin{equation}
\label{eq:KBoverKstar}
\frac{K_B(s)}{K_*}
=
\left(\frac{A}{A_*}\right)^2 (1 + \gamma |C|).
\end{equation}

\begin{theorem}[Curvature alignment]
We have
\[
\frac{K_B(s)}{K_*} = 1
\iff
A = A_*,\ C = 0.
\]
\end{theorem}

\begin{proof}
By \eqref{eq:KBoverKstar},
\[
\frac{K_B(s)}{K_*}
=
\left(\frac{A}{A_*}\right)^2 (1 + \gamma |C|).
\]
If $A = A_*, C = 0$, then this expression is $(1)^2 (1 + 0) = 1$.

Conversely, if $\dfrac{K_B(s)}{K_*} = 1$, we have
\[
\left(\frac{A}{A_*}\right)^2 (1 + \gamma |C|) = 1.
\]
The factors are nonnegative. If $\gamma > 0$, then $1 + \gamma |C| \ge 1$ with equality if and only if $C = 0$. Similarly, $\left(\frac{A}{A_*}\right)^2 \ge 0$. For the product to equal $1$, each factor must equal $1$, hence
\[
\frac{A}{A_*} = 1, \quad 1 + \gamma |C| = 1,
\]
which implies $A = A_*, C = 0$.
\end{proof}

\section{Universal controller}

Let $\mathcal{H}$ be a separable Hilbert space. Let $H_A, H_G, H_C$ be densely defined self-adjoint operators on $\mathcal{H}$, assumed to mutually commute:
\[
[H_A, H_G] = [H_A, H_C] = [H_G, H_C] = 0.
\]

For real constants $\lambda_A, \lambda_G, \lambda_C$, we define the controller generator
\begin{equation}
\label{eq:Koperator}
K(s) = \lambda_A (A - A_*) H_A
+ \lambda_G (G - 1) H_G
+ \lambda_C C H_C.
\end{equation}

The universal controller operator is
\begin{equation}
\label{eq:Uoperator}
U(s) = e^{i K(s)}.
\end{equation}

\subsection{Properties of $U(s)$}

\begin{theorem}[Unitarity]
For each $s \in \mathcal{S}$, the operator $U(s)$ is unitary.
\end{theorem}

\begin{proof}
The operator $K(s)$ is self-adjoint, being a real linear combination of self-adjoint, mutually commuting operators. For any self-adjoint operator $X$, the exponential $e^{iX}$ is unitary by the spectral theorem:
\[
e^{iX} e^{-iX} = e^{-iX} e^{iX} = I.
\]
Thus $U(s) = e^{iK(s)}$ is unitary.
\end{proof}

\begin{theorem}[Continuity of the controller]
Let $s_* \in \mathcal{S}$ be the attractor state, and assume $K(s)$ depends continuously on $s$ in the operator norm. Then
\[
\| U(s) - U(s_*) \| \to 0
\quad \text{as} \quad s \to s_*.
\]
\end{theorem}

\begin{proof}
The map $s \mapsto K(s)$ is continuous in operator norm by assumption. The exponential map $X \mapsto e^{iX}$ is continuous in operator norm for bounded self-adjoint operators. Therefore $U(s) = e^{iK(s)}$ is continuous in $s$ in operator norm. As $s \to s_*$, we have $K(s) \to K(s_*)$ and hence $U(s) \to U(s_*)$ in operator norm.
\end{proof}

\section{Unified emergence equation}

We now combine connectivity, curvature alignment, and controller alignment into a single emergent functional.

We define
\begin{equation}
\label{eq:Emergence}
\mathcal{E}_{\mathrm{conn}}(s)
=
\mathcal{K}_{\mathrm{norm}}(s)\,
\exp\left(
- \beta_K \left|\frac{K_B(s)}{K_*} - 1\right|^2
- \beta_U \|U(s) - U(s_*)\|^2
\right),
\end{equation}
where $\beta_K, \beta_U > 0$.

\begin{theorem}[Emergent coherence regime]
Under the assumptions $0 < G \le G_*$ and the definitions above, we have
\[
0 < \mathcal{E}_{\mathrm{conn}}(s) \le 1
\]
for all $s \in \mathcal{S}$, and
\[
\mathcal{E}_{\mathrm{conn}}(s) = 1
\]
if and only if
\[
A = A_*,\ C = 0,\ w = w_*,\ \sigma = 0,\ G = G_*,\ K_B(s) = K_*,\ U(s) = U(s_*).
\]
\end{theorem}

\begin{proof}
We have from the connectivity law that $\mathcal{K}_{\mathrm{norm}}(s) \in (0,1]$. The exponential factor is
\[
F(s) =
\exp\left(
- \beta_K \left|\frac{K_B(s)}{K_*} - 1\right|^2
- \beta_U \|U(s) - U(s_*)\|^2
\right).
\]
Each squared term in the exponent is nonnegative, so the exponent is $\le 0$. Thus
\[
0 < F(s) \le 1.
\]
Hence
\[
\mathcal{E}_{\mathrm{conn}}(s) =
\mathcal{K}_{\mathrm{norm}}(s)\,F(s)
\in (0,1]\cdot(0,1] = (0,1].
\]

We have $\mathcal{E}_{\mathrm{conn}}(s) = 1$ if and only if both factors equal $1$:
\[
\mathcal{K}_{\mathrm{norm}}(s) = 1, \quad F(s) = 1.
\]
From the connectivity law, $\mathcal{K}_{\mathrm{norm}}(s) = 1$ implies
\[
A = A_*,\ C = 0,\ w = w_*,\ \sigma = 0,\ G = G_*.
\]
The condition $F(s) = 1$ is equivalent to
\[
\left|\frac{K_B(s)}{K_*} - 1\right|^2 = 0, \quad \|U(s) - U(s_*)\|^2 = 0,
\]
that is,
\[
\frac{K_B(s)}{K_*} = 1, \quad U(s) = U(s_*).
\]
By curvature alignment, $\frac{K_B(s)}{K_*} = 1$ implies $A = A_*, C = 0$, which is consistent with the previous conditions. Thus all of these constraints must hold simultaneously for $\mathcal{E}_{\mathrm{conn}}(s)$ to reach $1$.
\end{proof}

\section{Final connectivity operator}

We define the final connectivity operator as
\begin{equation}
\label{eq:Oconn}
\mathcal{O}_{\mathrm{conn}}(s)
=
\mathcal{K}_{\mathrm{norm}}(s)\, U(s).
