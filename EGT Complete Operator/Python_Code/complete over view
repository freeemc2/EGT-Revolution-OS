# src/egt_unified.py

import numpy as np
from dataclasses import dataclass

# -----------------------------
# 1. EGT State and parameters
# -----------------------------

@dataclass
class EGTState:
    A: float
    G: float
    B: float
    C: float
    w: float
    sigma: float


@dataclass
class EGTParams:
    # Attractor values
    A_star: float = 402.0
    w_star: float = -1.0
    G_star: float = 1.0  # maximum connectivity scale

    # Coherence weights
    alpha_A: float = 1.0
    alpha_C: float = 1.0
    alpha_w: float = 1.0
    alpha_sigma: float = 1.0

    # Black-hole mapping constants
    k_M: float = 1.0
    k_Lambda: float = 1.0
    k_alpha: float = 1.0

    # Bres curvature constants
    kappa_0: float = 1.0
    gamma: float = 1.0

    # Controller couplings
    lambda_A: float = 1.0
    lambda_G: float = 1.0
    lambda_C: float = 1.0

    # Emergence penalties
    beta_K: float = 1.0
    beta_U: float = 1.0


# -----------------------------
# 2. Coherence functional
# -----------------------------

def coherence(s: EGTState, p: EGTParams) -> float:
    """Compute coherence C(s)."""
    dA = s.A - p.A_star
    dC = s.C
    dw = s.w - p.w_star
    ds = s.sigma

    exponent = (
        p.alpha_A * dA**2 +
        p.alpha_C * dC**2 +
        p.alpha_w * dw**2 +
        p.alpha_sigma * ds**2
    )
    return float(np.exp(-exponent))


# -----------------------------
# 3. Connectivity law
# -----------------------------

def connectivity(s: EGTState, p: EGTParams) -> float:
    """Compute K(s) = G * C(s)."""
    C = coherence(s, p)
    return s.G * C


def connectivity_normalized(s: EGTState, p: EGTParams) -> float:
    """Compute K_norm(s) = K(s) / G_star."""
    K = connectivity(s, p)
    return K / p.G_star


# -----------------------------
# 4. Black-hole mapping
# -----------------------------

@dataclass
class BlackHoleParams:
    M: float
    Lambda: float
    alpha: float


def black_hole_mapping(s: EGTState, p: EGTParams) -> BlackHoleParams:
    """
    Phi(s) = (M, Lambda, alpha).
    """
    M = p.k_M * s.A * s.G
    Lambda = p.k_Lambda * (1.0 + s.w)
    alpha = p.k_alpha * (s.G - 1.0) / (1.0 + s.sigma)
    return BlackHoleParams(M=M, Lambda=Lambda, alpha=alpha)


# -----------------------------
# 5. Bres curvature
# -----------------------------

def bres_radius(s: EGTState, p: EGTParams) -> float:
    """R_B(s) = B * A_star / A."""
    return s.B * p.A_star / s.A


def bres_curvature(s: EGTState, p: EGTParams) -> float:
    """
    K_B(s) = (kappa_0 / B^2) * (A/A_star)^2 * (1 + gamma |C|).
    """
    if s.B == 0:
        raise ValueError("B must be nonzero for Bres curvature.")
    factor = (s.A / p.A_star) ** 2
    return p.kappa_0 * factor * (1.0 + p.gamma * abs(s.C)) / (s.B ** 2)


def bres_curvature_reference(s: EGTState, p: EGTParams) -> float:
    """
    K_star = kappa_0 / B^2.
    """
    if s.B == 0:
        raise ValueError("B must be nonzero for reference curvature.")
    return p.kappa_0 / (s.B ** 2)


def bres_curvature_ratio(s: EGTState, p: EGTParams) -> float:
    """
    K_B(s) / K_star = (A / A_star)^2 * (1 + gamma |C|).
    """
    Kb = bres_curvature(s, p)
    Ks = bres_curvature_reference(s, p)
    return Kb / Ks


# -----------------------------
# 6. Universal controller (finite-dimensional toy)
# -----------------------------

class Controller:
    """
    Finite-dimensional toy implementation of H_A, H_G, H_C, and U(s).
    We assume all operators are NxN Hermitian matrices acting on C^N.
    """

    def __init__(self, H_A: np.ndarray, H_G: np.ndarray, H_C: np.ndarray):
        self.H_A = np.array(H_A, dtype=complex)
        self.H_G = np.array(H_G, dtype=complex)
        self.H_C = np.array(H_C, dtype=complex)

        # Sanity checks
        self._check_hermitian(self.H_A, "H_A")
        self._check_hermitian(self.H_G, "H_G")
        self._check_hermitian(self.H_C, "H_C")
        self._check_same_shape()

    @staticmethod
    def _check_hermitian(H: np.ndarray, name: str):
        if not np.allclose(H, H.conj().T):
            raise ValueError(f"{name} must be Hermitian.")

    def _check_same_shape(self):
        if not (self.H_A.shape == self.H_G.shape == self.H_C.shape):
            raise ValueError("H_A, H_G, H_C must have the same shape.")

    def generator(self, s: EGTState, p: EGTParams) -> np.ndarray:
        """
        K(s) = lambda_A (A - A_star) H_A +
               lambda_G (G - 1)        H_G +
               lambda_C C              H_C.
        """
        dA = s.A - p.A_star
        dG = s.G - 1.0
        dC = s.C

        K = (
            p.lambda_A * dA * self.H_A +
            p.lambda_G * dG * self.H_G +
            p.lambda_C * dC * self.H_C
        )
        return K

    def controller(self, s: EGTState, p: EGTParams) -> np.ndarray:
        """
        U(s) = exp(i K(s)) via diagonalization (toy).
        """
        K = self.generator(s, p)
        eigvals, eigvecs = np.linalg.eigh(K)  # Hermitian eigen-decomp
        phase = np.exp(1j * eigvals)
        U = eigvecs @ np.diag(phase) @ eigvecs.conj().T
        return U

    def controller_distance(self, s: EGTState, s_star: EGTState, p: EGTParams) -> float:
        """
        ||U(s) - U(s_star)||_2 (spectral norm).
        """
        U_s = self.controller(s, p)
        U_star = self.controller(s_star, p)
        diff = U_s - U_star
        # spectral norm via singular values
        sv = np.linalg.svd(diff, compute_uv=False)
        return float(np.max(sv))


# -----------------------------
# 7. Unified emergence functional
# -----------------------------

def emergence(s: EGTState, s_star: EGTState, p: EGTParams, ctrl: Controller) -> float:
    """
    E_conn(s) = K_norm(s) *
                exp(
                  - beta_K (K_B(s)/K_star - 1)^2
                  - beta_U ||U(s) - U(s_star)||^2
                )
    """
    K_norm = connectivity_normalized(s, p)
    ratio = bres_curvature_ratio(s, p)
    dK = ratio - 1.0
    dU = ctrl.controller_distance(s, s_star, p)

    exponent = (
        - p.beta_K * dK**2
        - p.beta_U * dU**2
    )
    return float(K_norm * np.exp(exponent))


# -----------------------------
# 8. Final connectivity operator
# -----------------------------

def connectivity_operator(s: EGTState, p: EGTParams, ctrl: Controller) -> np.ndarray:
    """
    O_conn(s) = K_norm(s) * U(s).
    """
    K_norm = connectivity_normalized(s, p)
    U = ctrl.controller(s, p)
    return K_norm * U
