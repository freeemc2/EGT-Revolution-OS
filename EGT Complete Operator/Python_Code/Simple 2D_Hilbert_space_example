import numpy as np
from egt_unified import (
    EGTState, EGTParams, Controller,
    coherence, connectivity_normalized,
    black_hole_mapping, bres_curvature_ratio,
    emergence, connectivity_operator,
)

def main():
    # Simple 2D Hilbert space example
    H_A = np.array([[1, 0], [0, -1]], dtype=complex)
    H_G = np.array([[0, 1], [1, 0]], dtype=complex)
    H_C = np.array([[0, -1j], [1j, 0]], dtype=complex)

    ctrl = Controller(H_A, H_G, H_C)
    p = EGTParams(G_star=1.5)  # example max connectivity

    s_star = EGTState(A=402.0, G=1.5, B=12.0, C=0.0, w=-1.0, sigma=0.0)
    s = EGTState(A=402.3, G=1.324, B=12.09776, C=2.99e-14, w=-0.9975, sigma=0.05)

    print("Coherence:", coherence(s, p))
    print("K_norm:", connectivity_normalized(s, p))
    print("BH mapping:", black_hole_mapping(s, p))
    print("Bres curvature ratio:", bres_curvature_ratio(s, p))
    print("Emergence:", emergence(s, s_star, p, ctrl))

    O = connectivity_operator(s, p, ctrl)
    print("Connectivity operator:\n", O)

if __name__ == "__main__":
    main()
