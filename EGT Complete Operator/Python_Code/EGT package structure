## 11. Emergence + connectivity operator

**File:** `egt_unified/src/egt_unified/emergence.py`

```python
import numpy as np
from .state import EGTState
from .params import EGTParams
from .connectivity import connectivity_normalized
from .bres import bres_curvature_ratio
from .controller import Controller


def emergence(s: EGTState, s_star: EGTState, p: EGTParams, ctrl: Controller) -> float:
    """
    Unified emergence functional:

    E_conn(s) = K_norm(s) *
                exp(
                  - beta_K (K_B(s)/K_star - 1)^2
                  - beta_U ||U(s) - U(s_star)||^2
                )
    """
    K_norm = connectivity_normalized(s, p)
    ratio = bres_curvature_ratio(s, p)
    dK = ratio - 1.0
    dU = ctrl.controller_distance(s, s_star, p)

    exponent = -p.beta_K * dK**2 - p.beta_U * dU**2
    return float(K_norm * np.exp(exponent))


def connectivity_operator(s: EGTState, p: EGTParams, ctrl: Controller) -> np.ndarray:
    """
    Final connectivity operator:

    O_conn(s) = K_norm(s) * U(s).
    """
    K_norm = connectivity_normalized(s, p)
    U = ctrl.controller(s, p)
    return K_norm * U
```

