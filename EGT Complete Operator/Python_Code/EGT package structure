```python
import numpy as np
from .state import EGTState
from .params import EGTParams


class Controller:
    """
    Finite-dimensional toy implementation of H_A, H_G, H_C, and U(s).

    H_A, H_G, H_C are NxN Hermitian matrices acting on C^N.
    """

    def __init__(self, H_A: np.ndarray, H_G: np.ndarray, H_C: np.ndarray):
        self.H_A = np.array(H_A, dtype=complex)
        self.H_G = np.array(H_G, dtype=complex)
        self.H_C = np.array(H_C, dtype=complex)

        self._check_hermitian(self.H_A, "H_A")
        self._check_hermitian(self.H_G, "H_G")
        self._check_hermitian(self.H_C, "H_C")
        self._check_same_shape()

    @staticmethod
    def _check_hermitian(H: np.ndarray, name: str):
        if not np.allclose(H, H.conj().T):
            raise ValueError(f"{name} must be Hermitian.")

    def _check_same_shape(self):
        if not (self.H_A.shape == self.H_G.shape == self.H_C.shape):
            raise ValueError("H_A, H_G, H_C must have the same shape.")

    def generator(self, s: EGTState, p: EGTParams) -> np.ndarray:
        """
        Generator:
        K(s) = lambda_A (A - A_star) H_A +
               lambda_G (G - 1)       H_G +
               lambda_C C             H_C.
        """
        dA = s.A - p.A_star
        dG = s.G - 1.0
        dC = s.C

        K = (
            p.lambda_A * dA * self.H_A
            + p.lambda_G * dG * self.H_G
            + p.lambda_C * dC * self.H_C
        )
        return K

    def controller(self, s: EGTState, p: EGTParams) -> np.ndarray:
        """
        U(s) = exp(i K(s)) via Hermitian diagonalization.
        """
        K = self.generator(s, p)
        eigvals, eigvecs = np.linalg.eigh(K)
        phase = np.exp(1j * eigvals)
        U = eigvecs @ np.diag(phase) @ eigvecs.conj().T
        return U

    def controller_distance(self, s: EGTState, s_star: EGTState, p: EGTParams) -> float:
        """
        Spectral norm of the difference:
        ||U(s) - U(s_star)||_2.
        """
        U_s = self.controller(s, p)
        U_star = self.controller(s_star, p)
        diff = U_s - U_star
        sv = np.linalg.svd(diff, compute_uv=False)
        return float(np.max(sv))
