from dataclasses import dataclass
from .state import EGTState
from .params import EGTParams


@dataclass
class BlackHoleParams:
    M: float
    Lambda: float
    alpha: float


def black_hole_mapping(s: EGTState, p: EGTParams) -> BlackHoleParams:
    """
    Black-hole mapping Phi(s) = (M, Lambda, alpha):

    M      = k_M * A * G
    Lambda = k_Lambda * (1 + w)
    alpha  = k_alpha * (G - 1) / (1 + sigma)
    """
    M = p.k_M * s.A * s.G
    Lambda = p.k_Lambda * (1.0 + s.w)
    alpha = p.k_alpha * (s.G - 1.0) / (1.0 + s.sigma)
    return BlackHoleParams(M=M, Lambda=Lambda, alpha=alpha)
