## 9. Bres curvature

**File:** `egt_unified/src/egt_unified/bres.py`

```python
from .state import EGTState
from .params import EGTParams


def bres_radius(s: EGTState, p: EGTParams) -> float:
    """
    Bres radius:
    R_B(s) = B * A_star / A.
    """
    if s.A == 0:
        raise ValueError("A must be nonzero for Bres radius.")
    return s.B * p.A_star / s.A


def bres_curvature(s: EGTState, p: EGTParams) -> float:
    """
    Bres curvature:
    K_B(s) = (kappa_0 / B^2) * (A/A_star)^2 * (1 + gamma |C|).
    """
    if s.B == 0:
        raise ValueError("B must be nonzero for Bres curvature.")
    factor = (s.A / p.A_star) ** 2
    return p.kappa_0 * factor * (1.0 + p.gamma * abs(s.C)) / (s.B ** 2)


def bres_curvature_reference(s: EGTState, p: EGTParams) -> float:
    """
    Reference curvature:
    K_star = kappa_0 / B^2.
    """
    if s.B == 0:
        raise ValueError("B must be nonzero for reference curvature.")
    return p.kappa_0 / (s.B ** 2)


def bres_curvature_ratio(s: EGTState, p: EGTParams) -> float:
    """
    Ratio K_B(s) / K_star = (A / A_star)^2 * (1 + gamma |C|).
    """
    Kb = bres_curvature(s, p)
    Ks = bres_curvature_reference(s, p)
    return Kb / Ks
