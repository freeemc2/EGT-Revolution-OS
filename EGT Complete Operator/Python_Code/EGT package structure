## 6. Coherence

**File:** `egt_unified/src/egt_unified/coherence.py`

```python
import numpy as np
from .state import EGTState
from .params import EGTParams


def coherence(s: EGTState, p: EGTParams) -> float:
    """
    Coherence functional C(s):
    C(s) = exp( -[alpha_A (A-A*)^2 + alpha_C C^2 + alpha_w (w-w*)^2 + alpha_sigma sigma^2] ).
    """
    dA = s.A - p.A_star
    dC = s.C
    dw = s.w - p.w_star
    ds = s.sigma

    exponent = (
        p.alpha_A * dA**2
        + p.alpha_C * dC**2
        + p.alpha_w * dw**2
        + p.alpha_sigma * ds**2
    )
    return float(np.exp(-exponent))
```

